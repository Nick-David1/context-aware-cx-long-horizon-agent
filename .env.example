# ---- MongoDB Atlas ----
# Must be an Atlas cluster (M0 free tier works) — Vector Search is not available on local mongod.
MONGODB_URI="mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="horizon"

# ---- Anthropic (agent reasoning + reflection) ----
ANTHROPIC_API_KEY="sk-ant-..."

# ---- Retrieval: embeddings and reranking ----
# Both default to running INSIDE MongoDB, so no model key is needed here.
#
#   EMBEDDING_MODE=auto   Atlas embeds documents on write and the query at read
#                         time, from an autoEmbed index. No key, no vectors on
#                         the wire. Set to "client" to embed in our process.
#   RERANK_MODE=native    Atlas runs the cross-encoder as a $rerank aggregation
#                         stage. Needs MongoDB 8.3+ with Native Reranking on in
#                         Project Settings; downgrades to "client" by itself if
#                         the stage is rejected. Also accepts "client" or "off".
#   RETRIEVAL_MODE=hybrid  $rankFusion over $vectorSearch + BM25 $search (RRF).
#                         Set to "vector" for vector-only.
RETRIEVAL_MODE="hybrid"
EMBEDDING_MODE="auto"
RERANK_MODE="native"

# Only needed for EMBEDDING_MODE=client or RERANK_MODE=client.
# Create it in the Atlas UI: AI Model APIs -> Create model API key.
VOYAGE_API_KEY=""

# Set only if using a standalone voyageai.com key instead of an Atlas model API
# key. The two are NOT interchangeable — the wrong host returns 403.
# VOYAGE_BASE_URL="https://api.voyageai.com/v1"

# ---- ElevenLabs (Conversational AI voice agent) ----
ELEVENLABS_API_KEY="sk_..."
ELEVENLABS_AGENT_ID=""
ELEVENLABS_PHONE_NUMBER_ID=""

# Shared secret ElevenLabs sends back on every server-tool webhook call.
TOOL_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# Public base URL the ElevenLabs agent calls for tools (use an ngrok/tunnel URL in dev).
PUBLIC_BASE_URL="https://your-tunnel.ngrok-free.app"
