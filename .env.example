# ---- MongoDB Atlas ----
# Must be an Atlas cluster (M0 free tier works) — Vector Search is not available on local mongod.
MONGODB_URI="mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="horizon"

# ---- Anthropic (agent reasoning + reflection) ----
ANTHROPIC_API_KEY="sk-ant-..."

# ---- Voyage AI (embeddings for Atlas Vector Search) ----
# Optional. If unset, the app falls back to a deterministic local embedder so the
# demo still runs end-to-end (quality is much worse — set this for the real demo).
VOYAGE_API_KEY=""

# ---- ElevenLabs (Conversational AI voice agent) ----
ELEVENLABS_API_KEY="sk_..."
ELEVENLABS_AGENT_ID=""
ELEVENLABS_PHONE_NUMBER_ID=""

# Shared secret ElevenLabs sends back on every server-tool webhook call.
TOOL_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# Public base URL the ElevenLabs agent calls for tools (use an ngrok/tunnel URL in dev).
PUBLIC_BASE_URL="https://your-tunnel.ngrok-free.app"
